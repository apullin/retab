digraph cf_pipeline {
  rankdir=TB;
  node [shape=box, style=filled];

  // === COLORS ===
  // Green = pure Rust (no Python delegate)
  // Yellow = Rust orchestration, delegates specific sub-ops to Python
  // Orange = Rust wrapper, full Python delegate
  // Red = pure Python, called directly from preprocess.py
  // Gray = upstream ET (can't eliminate)
  // Blue = Python support module (needed by delegates)

  // === preprocess.py pipeline steps ===
  subgraph cluster_pipeline {
    label="preprocess.py pipeline";
    style=dashed;

    pre_phase [label="1. stamp_control_flow_metadata(gm)", fillcolor=green3];
    fx_passes [label="2. run_fx_passes(gm, ep)", fillcolor=green3];
    cf_submod [label="3. run_fx_{cond,submodule}_passes", fillcolor=green3];

    // Boundary phase
    cf_rewrite_qb [label="4. cf_rewrite_quantization_boundaries", fillcolor=yellow];
    cf_reapply_br [label="5. cf_reapply_boundary_rescales\n(include_inputs=True)", fillcolor=orange];
    et_rescale [label="6. InsertRescaleInt32Pass\non submodules", fillcolor=gray80];
    stamp2 [label="7. stamp_control_flow_metadata", fillcolor=green3];
    cf_restore_ir [label="8. cf_restore_missing_input_rescales", fillcolor=orange];
    refresh_binary [label="9. _refresh_control_flow_\nbinary_input_rescales\n(813 lines)", fillcolor=red, penwidth=3];

    // Output normalize phase (single Rust call)
    normalize [label="10. cf_run_output_normalize_phase\n(11 steps in one Rust call)", fillcolor=yellow];

    // Serialize
    serialize [label="11. ingest_and_serialize", fillcolor=green3];
    delegate_meta [label="12. _collect_delegate_info_meta", fillcolor=lightblue];
  }

  pre_phase -> fx_passes -> cf_submod -> cf_rewrite_qb;
  cf_rewrite_qb -> cf_reapply_br -> et_rescale -> stamp2;
  stamp2 -> cf_restore_ir -> refresh_binary;
  refresh_binary -> normalize -> serialize -> delegate_meta;

  // === Python modules still loaded at runtime ===
  subgraph cluster_python {
    label="Python modules loaded at runtime";
    style=dashed; color=red;

    cf_rewrites [label="_cf_rewrites.py\n~1400 lines", fillcolor=lightsalmon];
    control_flow [label="_control_flow.py\n~3900 lines", fillcolor=lightsalmon];
    cf_ctx [label="_cf_ctx.py\n~200 lines", fillcolor=lightblue];
    helpers [label="_helpers.py / fx_helpers\n(insert_rescale_node)", fillcolor=lightsalmon];
    decomp_hooks [label="_decomp_hooks.py\n400 lines\n(MUST stay Python)", fillcolor=gray80];
  }

  // === What calls what ===

  // Rust delegates -> Python
  cf_rewrite_qb -> cf_rewrites [label="3 sub-fns:\ncollapse_qdq_pairs\nrewrite_quantize_nodes\nrewrite_dequantize_nodes", style=dashed, color=orange];
  cf_rewrite_qb -> control_flow [label="_cleanup_graph", style=dashed, color=orange];
  cf_rewrite_qb -> cf_ctx [label="CfSubmoduleCtx", style=dashed, color=orange];

  cf_reapply_br -> control_flow [label="_reapply_control_flow_\nboundary_rescales\n(full delegate, 90 lines)", style=dashed, color=red];

  cf_restore_ir -> cf_rewrites [label="_restore_missing_control_flow_\ninput_rescales\n(full delegate, 55 lines)", style=dashed, color=red];

  refresh_binary -> control_flow [label="DIRECT Python call\n813 lines + 30 helpers", style=bold, color=red];
  refresh_binary -> helpers [label="insert_rescale_node\n(creates FX nodes)", style=dashed, color=red];

  // Normalize phase internal delegates
  normalize -> cf_rewrites [label="_normalize_output_contracts\n_restore_missing_input_rescales", style=dashed, color=orange];
  normalize -> control_flow [label="_reapply_boundary_rescales\n_quantize_constant_only_outputs\n_cleanup_graph", style=dashed, color=orange];

  // Metadata stamp Rust delegates
  pre_phase -> cf_ctx [label="_get_matching_fake_tensor", style=dashed, color=blue];
  pre_phase -> control_flow [label="_branch_local_output_qparam\n_extract_single_qparam_entry\n_extract_effective_node_qparam", style=dashed, color=blue];

  delegate_meta -> cf_ctx [label="_collect_delegate_info_meta\n(14 lines, read-only)", style=dashed, color=blue];

  // ET dependency
  et_rescale -> et_pass [label="upstream ET pass\ncan't eliminate"];
  cf_reapply_br -> et_icfr [label="InsertControlFlowRescalesPass\n(used internally)", style=dashed, color=gray];

  et_pass [label="InsertRescaleInt32Pass\n(ET upstream, 370 lines)", fillcolor=gray80];
  et_icfr [label="InsertControlFlowRescalesPass\n(ET upstream, 220 lines)", fillcolor=gray80];
  quant_args [label="QuantArgs\n(ET data class)", fillcolor=gray80];

  refresh_binary -> quant_args [style=dashed, color=gray];

  // === LEGEND ===
  subgraph cluster_legend {
    label="Legend";
    style=solid;
    l1 [label="Pure Rust", fillcolor=green3, shape=box];
    l2 [label="Rust + Python sub-ops", fillcolor=yellow, shape=box];
    l3 [label="Rust wrapper (full delegate)", fillcolor=orange, shape=box];
    l4 [label="Pure Python", fillcolor=red, shape=box];
    l5 [label="Upstream ET (can't change)", fillcolor=gray80, shape=box];
    l6 [label="Light Python support", fillcolor=lightblue, shape=box];
  }
}
